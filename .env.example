# ---------------------------------------------------------------------------
# Weitblick – Konfiguration für den Betrieb auf dem eigenen Rechner.
# Für GitHub Pages ist keine Konfiguration nötig. Alles ist kostenlos.
# ---------------------------------------------------------------------------

# Nachrichten alle … Minuten abrufen
REFRESH_INTERVAL_MINUTES=15
# Meldungen so viele Tage aufbewahren
RETENTION_DAYS=30

# Kostenlose Übersetzung DE <-> EN mit OPUS-MT (benötigt requirements-translate.txt)
TRANSLATION_ENABLED=true
# Höchstens so viele Sekunden pro Durchlauf übersetzen
TRANSLATION_TIME_BUDGET_SECONDS=300

# Schützt den Endpunkt POST /api/admin/refresh (Header: X-Admin-Token)
ADMIN_TOKEN=
LOG_LEVEL=INFO
