# ---------------------------------------------------------------------------
# Weitblick – Konfiguration. Kopieren nach `.env` und Werte eintragen.
# ---------------------------------------------------------------------------

# --- KI-Zusammenfassungen (Claude) -----------------------------------------
# Ohne Schlüssel zeigt die App automatische Auszüge in der Originalsprache.
ANTHROPIC_API_KEY=
# Modell für Zusammenfassungen & Briefings (Standard: claude-opus-5-5).
# Günstigere Alternativen: claude-sonnet-5-5 oder claude-haiku-5-5
LLM_MODEL=claude-opus-5-5
# Denktiefe: low | medium | high
LLM_EFFORT=medium
# Wie viele Meldungen pro Durchlauf per KI zusammengefasst werden (wichtigste zuerst)
SUMMARIES_PER_CYCLE=20
# Kostenbremse: höchstens so viele KI-Zusammenfassungen pro Tag (0 = unbegrenzt)
LLM_DAILY_LIMIT=200
# Gleichzeitige KI-Anfragen
LLM_CONCURRENCY=4
# Briefings neu erstellen alle … Minuten (Tag, Kategorien, Woche)
DIGEST_INTERVAL_MINUTES=60
CATEGORY_DIGEST_INTERVAL_MINUTES=180
WEEKLY_DIGEST_INTERVAL_MINUTES=360

# --- Nachrichtenabruf ------------------------------------------------------
REFRESH_INTERVAL_MINUTES=15
# Volltext der Artikel für bessere Zusammenfassungen laden (nur intern genutzt)
FETCH_FULLTEXT=true
RETENTION_DAYS=30

# --- Sprachausgabe (optional, sonst Stimmen des Geräts) --------------------
# auto | azure | openai | elevenlabs | browser
TTS_PROVIDER=auto

# Azure AI Speech (empfohlen, kostenloses Kontingent: 0,5 Mio. Zeichen/Monat)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Stimmen anpassen (Standard: Seraphina/Florian bzw. Ava/Andrew)
# AZURE_VOICE_DE_FEMALE=de-DE-SeraphinaMultilingualNeural
# AZURE_VOICE_DE_MALE=de-DE-FlorianMultilingualNeural
# AZURE_VOICE_EN_FEMALE=en-US-AvaMultilingualNeural
# AZURE_VOICE_EN_MALE=en-US-AndrewMultilingualNeural

# OpenAI Text-to-Speech
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_VOICE_FEMALE=nova
# OPENAI_VOICE_MALE=onyx

# ElevenLabs
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_FEMALE=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_VOICE_MALE=pNInz6obpgDQGcFmaJgB

# --- Sonstiges -------------------------------------------------------------
# Schützt den Endpunkt POST /api/admin/refresh (Header: X-Admin-Token)
ADMIN_TOKEN=
LOG_LEVEL=INFO
